# Copy to .env for local development. NEVER commit real values. All defaults below are
# development-only and are REJECTED when ARTIFY_ENVIRONMENT is staging/production.
ARTIFY_ENVIRONMENT=local

# Four distinct database identities; none may be the schema owner and none has BYPASSRLS.
ARTIFY_DATABASE_URL_APP=postgresql+psycopg://artify_app_login:dev-only-app@localhost:5432/artify
ARTIFY_DATABASE_URL_PLATFORM=postgresql+psycopg://artify_platform_login:dev-only-platform@localhost:5432/artify
ARTIFY_DATABASE_URL_DISPATCHER=postgresql+psycopg://artify_dispatcher_login:dev-only-dispatcher@localhost:5432/artify
# Schema owner: migrations, seed and bootstrap only (superuser or BYPASSRLS operations role).
ARTIFY_DATABASE_URL_MIGRATE=postgresql+psycopg://postgres:postgres@localhost:5432/artify

ARTIFY_REDIS_URL=redis://localhost:6379/0
ARTIFY_RATE_LIMIT_BACKEND=memory      # must be "redis" in staging/production
ARTIFY_MAILER_BACKEND=console         # prints verification/reset links (local only)

# Token signing keys: one per realm, >= 32 chars, must differ. Generate real ones with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ARTIFY_TENANT_JWT_SECRET=
# ARTIFY_PLATFORM_JWT_SECRET=
# Fernet key protecting TOTP secrets: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ARTIFY_MFA_ENCRYPTION_KEY=

# Web app (server-side only; never exposed to the browser)
ARTIFY_API_URL=http://localhost:8000/api/v1
# APP_SURFACE=all    # console | platform | all (all = local development)
