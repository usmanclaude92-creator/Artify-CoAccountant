{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Artify Co-Accountant",
  "version": "0.1.0",
  "identifier": "com.artify.coaccountant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Artify Co-Accountant",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Artify",
    "copyright": "Copyright (c) Artify. All rights reserved.",
    "category": "Business",
    "shortDescription": "Artify Co-Accountant for Windows",
    "longDescription": "The accountant's workspace for Artify Co-Accountant: sign in, choose a company and work in its configured workspace.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "createUpdaterArtifacts": false
  }
}
